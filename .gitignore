.env-metafashion-kanban
.env*
node_modules/
.next/
dist/
build/

# internal coordination/process docs, not for the repo
docs/
TEST-hey.md

# local Excel workbook exports, never committed
*.xlsx

# Playwright MCP browser session artifacts (snapshots, console logs, screenshots)
.playwright-mcp/

# Codex CLI local config, per-machine and not shared
.codex/

# GitButler installs its own managed hooks locally and chains ours as pre-commit-user
.githooks/pre-commit-user
.githooks/post-checkout

# npm lockfile: this is a pnpm workspace. A package-lock.json arrived with the
# catalog-intel sync and would resolve a different dependency tree from CI, with none
# of the minimumReleaseAge / trustPolicy hardening in web/pnpm-workspace.yaml.
package-lock.json
