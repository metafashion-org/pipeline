{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:migrate": "tsx lib/db/run-migrate.ts",
    "db:seed": "tsx lib/db/seed-statuses.ts",
    "db:seed:marketing": "tsx lib/marketing/marketing-service.ts",
    "db:seed:e2e": "tsx lib/db/seed-e2e-fixtures.ts",
    "test:db:up": "bash scripts/test-db.sh up",
    "test:db:down": "bash scripts/test-db.sh down",
    "test:e2e": "playwright test",
    "deadcode": "knip --include files,dependencies,unlisted,binaries",
    "deadcode:all": "knip",
    "typecheck": "tsc --noEmit",
    "prepare": "cd .. && git config core.hooksPath .githooks",
    "doctor": "npx react-doctor@latest"
  },
  "dependencies": {
    "@base-ui/react": "^1.2.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^0.564.0",
    "next": "16.2.12",
    "next-auth": "^4.24.15",
    "next-themes": "^0.4.6",
    "postgres": "^3.4.9",
    "radix-ui": "^1.4.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "sonner": "^2.0.7",
    "swr": "^2.4.0",
    "tailwind-merge": "^3.4.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "knip": "^6.32.2",
    "shadcn": "^3.8.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "sharp",
      "unrs-resolver"
    ]
  }
}
